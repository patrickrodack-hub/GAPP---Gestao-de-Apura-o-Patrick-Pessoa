# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Utilizada para leitura multimodal inteligente de relatórios de venda (PDF/Imagem).
# No AI Studio ela é injetada automaticamente. Na Vercel, pode ser configurada como GEMINI_API_KEY ou VITE_GEMINI_API_KEY.
# Observação: O motor de cotações (CEPEA/ESALQ-USP, Banco Central PTAX, Yahoo Finance, Coinbase Spot e BCE)
# utiliza endpoints públicos oficiais e NÃO depende de chave de API para funcionar em tempo real.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
